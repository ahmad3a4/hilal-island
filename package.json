{
  "name": "hilal-island",
  "productName": "Hilal",
  "version": "1.2.0",
  "description": "Hilal: a Dynamic Island for Windows with music, downloads, prayer times, azan and azkar.",
  "main": "src/main/main.js",
  "private": true,
  "author": "Ahmad",
  "license": "MIT",
  "homepage": "https://github.com/ahmad3a4/hilal-island",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmad3a4/hilal-island.git"
  },
  "keywords": [
    "dynamic-island",
    "windows",
    "electron",
    "prayer-times",
    "azan",
    "adhan",
    "azkar",
    "quran",
    "downloader"
  ],
  "scripts": {
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js",
    "dist": "node scripts/build-helper.js && electron-builder --win --x64",
    "build:helper": "node scripts/build-helper.js",
    "fetch:ayat": "node scripts/fetch-ayat.js",
    "test:prayer": "node scripts/test-prayer.js",
    "test:downloads": "node scripts/test-downloads.js"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.ahmad3a4.hilal",
    "productName": "Hilal",
    "copyright": "Copyright (c) 2026 Ahmad",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/bin/HilalHelper.exe",
        "to": "native/HilalHelper.exe"
      }
    ],
    "asar": false,
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "artifactName": "Hilal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ar_SA"
      ],
      "license": "LICENSE",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "shortcutName": "Hilal",
      "uninstallDisplayName": "Hilal",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
